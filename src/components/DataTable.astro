---
import { rich } from "../lib/format"
interface Props { head?: string[]; rows: string[][]; plain?: boolean; compact?: boolean }
const { head = [], rows, plain = false, compact = false } = Astro.props
---
<div class="table-wrap">
  <table class={compact ? "compact" : plain ? "plain" : "stack"}>
    {head.length > 0 && (
      <thead><tr>{head.map((c) => <th scope="col">{c}</th>)}</tr></thead>
    )}
    <tbody>
      {rows.map((r) => (
        <tr>{r.map((c, i) => <td data-label={head[i] ?? ""}><Fragment set:html={rich(c)} /></td>)}</tr>
      ))}
    </tbody>
  </table>
</div>
