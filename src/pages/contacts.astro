---
import Base from "../layouts/Base.astro"
import LinkBtn from "../components/LinkBtn.astro"
import DataTable from "../components/DataTable.astro"
import CareCards from "../components/CareCards.astro"
import { data } from "../data/content"
import { rich, telHref, waHref } from "../lib/format"
const C = data.contacts
const s = C.school
const mapUrl = "https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent(s.address)
---
<Base title="Contacts" lead="Tap a number to call or an address to open it. Only school and business contacts are listed.">

  <article class="card contact main-contact">
    <h2>{s.name}</h2>
    <p class="role">{s.address}</p>
    <div class="links">
      <LinkBtn label={`Call ${s.phone}`} href={telHref(s.phone)} kind="tel" />
      <LinkBtn label={s.email} href={`mailto:${s.email}`} kind="mail" />
      <LinkBtn label="Open map" href={mapUrl} kind="map" />
      <LinkBtn label="School website" href={s.web} kind="web" />
      <LinkBtn label="Facebook" href={s.facebook} kind="facebook" />
      <LinkBtn label="Instagram" href={s.instagram} kind="instagram" />
    </div>
    {s.hours && <p class="hours">{s.hours}</p>}
    <p>For urgent matters, contact the General Office. Teachers may not reply on the same day.</p>
  </article>

  <section id="how-to-reach-the-school" class="reach">
    <span id="communicating-with-the-school"></span>
    <h2 class="section-h">How to reach the school</h2>
    <ul class="facts">{C.reach.map((it) => <li><Fragment set:html={rich(it.t)} /></li>)}</ul>
  </section>

  <section id="student-care">
    <h2 class="section-h">Student care</h2>
    <CareCards />
  </section>

  <section id="suppliers-and-services">
  <h2 class="section-h">Suppliers and services</h2>
  <div class="card-grid">
  {C.vendors.map((v) => (
    <article class="card contact">
      <h3>{v.name}</h3>
      <p class="role">{v.role}</p>
      {v.address && <p>{v.address}</p>}
      {v.person && <p>{v.person}</p>}
      {v.note && <p>{v.note}</p>}
      <div class="links">
        {v.phones.map((p) => <LinkBtn label={`Call ${p}`} href={telHref(p)} kind="tel" />)}
        {v.whatsapp && <LinkBtn label={`WhatsApp ${v.whatsapp}`} href={waHref(v.whatsapp)} kind="whatsapp" />}
        {v.email && <LinkBtn label={v.email} href={`mailto:${v.email}`} kind="mail" />}
        {v.web && <LinkBtn label="Website" href={v.web} kind="web" />}
      </div>
    </article>
  ))}
  </div>
  </section>

  <section id="school-leaders">
    <h2 class="section-h">School leaders and Year Head</h2>
    <p class="lead">{C.staffNote}</p>
    <DataTable plain head={["Name", "Role"]} rows={C.staff.flatMap((g) => g.rows)} />
  </section>
</Base>
