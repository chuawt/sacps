---
import Base from "../layouts/Base.astro"
import Blocks from "../components/Blocks.astro"
import { data } from "../data/content"
const L = data.life
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")
---
<Base title="School life" lead={L.intro}>
  {L.sections.map((s) => (
    <details class="acc" id={slug(s.title)}>
      <summary><span>{s.title}</span></summary>
      <div class="acc-body"><Blocks blocks={s.blocks} /></div>
    </details>
  ))}
  <script>
    const open = () => {
      const id = decodeURIComponent(location.hash.slice(1))
      const el = id ? document.getElementById(id) : null
      if (el instanceof HTMLDetailsElement) { el.open = true; el.scrollIntoView() }
    }
    open()
    window.addEventListener("hashchange", open)
  </script>
</Base>
