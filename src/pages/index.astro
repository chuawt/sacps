---
import fs from "node:fs"
import path from "node:path"
import Base from "../layouts/Base.astro"
import { data } from "../data/content"
import { fmt, longDate } from "../lib/format"
const events = [...data.events].sort((a, b) => a.date.localeCompare(b.date))
const route = { before: "/before-school/", weeks: "/first-weeks/", life: "/school-life/#2027-school-terms-and-holidays" }
const heroFile = path.join(process.cwd(), "public", "hero", "hero.png")
let hero: { w: number; h: number } | null = null
try {
  if (fs.existsSync(heroFile)) {
    const b = fs.readFileSync(heroFile)
    hero = { w: b.readUInt32BE(16) || 1600, h: b.readUInt32BE(20) || 640 }
  }
} catch {
  hero = null
}
const tiles = [
  { href: "/first-weeks/", title: "First weeks", text: "The first days, day by day, and what to pack." },
  { href: "/before-school/", title: "Before school", text: "Books, uniform, nametags, forms and payments." },
  { href: "/school-life/", title: "School life", text: "School day, hours, pick-up, uniform, recess and more." },
  { href: "/contacts/", title: "Contacts", text: "School office, suppliers and student care." },
  { href: "/about/", title: "About this site", text: "Who runs it, and what it is not." },
]
---
<Base title="Coming up" heading="Coming up" h1="P1 2027 at St Anthony's Canossian Primary School" bare>
  <section class="hero">
    <div class="hero-art" aria-hidden={hero ? undefined : "true"}>
      {hero
        ? <picture style="display:contents"><source srcset="/hero/hero.webp" type="image/webp" /><img src="/hero/hero.png" width={hero.w} height={hero.h} alt="Pixel-art painting of two Primary 1 girls in white blouses and blue pinafores" fetchpriority="high" /></picture>
        : <div class="hero-placeholder"></div>}
    </div>
    <div class="page-width hero-inner">
      <div class="hero-text">
        <p class="eyebrow">For P1 2027 parents</p>
        <h1>Unofficial P1 2027 SACPS Hub</h1>
        <p class="hero-lead">Dates, to-dos and school routines for parents of daughters starting Primary 1 at St Anthony's Canossian Primary School in January 2027.</p>
        <aside class="next-card js-only" id="next-up" aria-live="polite" hidden>
          <p class="next-eyebrow">Next date</p>
          <h2 class="next-title" data-next-title></h2>
          <p class="next-count" data-next-count></p>
          <p class="next-when" data-next-when></p>
          <a class="btn small" data-next-link href="/before-school/">See the details</a>
        </aside>
        <p class="hero-note">Run by a parent, not by the school. Check <strong>Parents Gateway</strong> and school announcements for updates.</p>
      </div>
    </div>
  </section>

  <section class="page-width tiles-wrap" aria-labelledby="explore">
    <h2 class="eyebrow-h" id="explore">Find your way around</h2>
    <ul class="tiles">
      {tiles.map((t) => (
        <li><a class="tile" href={t.href}><span class="tile-title">{t.title}</span><span class="tile-text">{t.text}</span></a></li>
      ))}
    </ul>
  </section>

  <div class="page-width page-body home-grid">
    <div class="home-main">
      <h2 class="section-h first">Coming up</h2>
      <p class="lead">Dates are counted in Singapore time. Items drop off after they pass.</p>

      <div class="card empty" id="ev-empty" hidden>All the dated items have passed. Use <a href="/school-life/">School life</a> for day-to-day reference.</div>

      <ol class="events" id="ev-list">
        {events.map((e) => (
          <li class="ev" data-event data-date={e.date} data-end={e.endDate ?? e.date}>
            <div class="ev-date" aria-hidden="true">
              <span class="d">{fmt(e.date, { day: "numeric" })}</span>
              <span class="m">{fmt(e.date, { month: "short" })}</span>
              <span class="y">{fmt(e.date, { year: "numeric" })}</span>
            </div>
            <div class="ev-body">
              <p class="next-label">Next up</p>
              <p class="count" data-countdown></p>
              <h3>{e.title}</h3>
              <p class="when">
                {longDate(e.date)}{e.endDate ? ` to ${longDate(e.endDate)}` : ""}{e.time ? `, ${e.time}` : ""}
              </p>
              <p>{e.detail}</p>
              <div class="btn-row"><a class="btn small ghost" href={route[e.go]}>See the details</a></div>
            </div>
          </li>
        ))}
      </ol>
      <div class="btn-row"><button class="btn ghost small js-only" id="ev-more" type="button" hidden aria-expanded="false"></button></div>
    </div>

    <aside class="home-side">
      <h2 class="section-h first">A normal school day, at a glance</h2>
      <dl class="key-times">
        {data.keyTimes.map((k) => (
          <div><dt>{k.label}</dt><dd>{k.value}</dd></div>
        ))}
      </dl>
      <p>More in <a href="/school-life/">School life</a>. Phone and address are under <a href="/contacts/">Contacts</a>.</p>
    </aside>
  </div>
</Base>
